{
  "state": "NY",
  "displayName": "New York",
  "reviewProcesses": {
    "reg74": true,
    "reg187": true,
    "replacementReview": true,
    "suitabilityReview": true
  },
  "specialNotes": [
    "Signed matching illustration required",
    "FR2361 required for all cases",
    "F5500NY is not acceptable",
    "Preliminary Information Sales Presentation required",
    "F6512 required for replacement cases",
    "Trust Certificate must use F6734NY",
    "FR1126NY required for Internal Term-to-Term replacements",
    "N201-NY-399 required for Variable Life applications",
    "F3669 required for New York Variable Life applications"
  ],
  "forms": [
    {
      "form": "A2000NY",
      "description": "Application for Individual Life Insurance Part 1",
      "required": true,
      "reviewRequired": true,
      "condition": "Required for all cases",
      "conditions": []
    },
    {
      "form": "FR2361",
      "description": "Authorization of Proposed Insured to Obtain and Disclose Information",
      "required": true,
      "reviewRequired": true,
      "condition": "Required for all cases",
      "conditions": []
    },
    {
      "form": "F8186GEN",
      "description": "HIPAA Authorization",
      "required": true,
      "reviewRequired": true,
      "condition": "Required for all cases",
      "conditions": []
    },
    {
      "form": "FR3120",
      "description": "Producer Statement",
      "required": true,
      "reviewRequired": true,
      "condition": "Required for all cases",
      "conditions": []
    },
    {
      "form": "N201NY",
      "description": "HIV Consent Form",
      "required": true,
      "reviewRequired": true,
      "condition": "Required for all cases",
      "conditions": []
    },
    {
      "form": "FR2282",
      "description": "Life Products Suitability Questionnaire",
      "required": false,
      "reviewRequired": true,
      "condition": "Use unless the owner is an irrevocable trust whose trust assets are paying the premium, or the owner is a business",
      "conditions": [
        {
          "field": "suitabilityQuestionnaireRequired",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "FR2193",
      "description": "Source of Funds Questionnaire",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for applicable non-Term Life cases submitted by MassMutual Career Agents or MMLIS Registered Representatives",
      "conditions": [
        {
          "field": "sourceOfFundsRequired",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "A50NY",
      "description": "Application Part 2",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when medical underwriting requires the paper Part 2 instead of an online CMI or Tele-CMI",
      "conditions": [
        {
          "field": "paperPart2Required",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "F6484",
      "description": "Replacement Form",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for Life replacement cases",
      "conditions": [
        {
          "field": "replacement",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "F6512",
      "description": "New York Regulation 60 Pre-Sale Disclosure",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for applicable Life replacement cases",
      "conditions": [
        {
          "field": "replacement",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "F5159NY",
      "description": "Beneficiary Designation Form",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when Other is selected in Part 1 Section E-2",
      "conditions": [
        {
          "field": "beneficiaryOther",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "F5248NY",
      "description": "Owner Designation Form",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when the owner is anyone other than the insured",
      "conditions": [
        {
          "field": "ownerType",
          "operator": "notEquals",
          "value": "insured"
        }
      ]
    },
    {
      "form": "F6445",
      "description": "Pre-Authorized Check Premium Payment Service",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when the billing type is PAC or EFT",
      "conditions": [
        {
          "field": "billingType",
          "operator": "includes",
          "value": ["pac", "eft"]
        }
      ]
    },
    {
      "form": "R20NY",
      "description": "Temporary Life Insurance Receipt",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when temporary life insurance is requested",
      "conditions": [
        {
          "field": "tlirRequested",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "F6734NY",
      "description": "New York Trust Certificate",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when the owner is a trust",
      "conditions": [
        {
          "field": "ownerType",
          "operator": "equals",
          "value": "trust"
        }
      ]
    },
    {
      "form": "FR2089NY",
      "description": "Conversion and Insurability Option Supplement",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for Conversion or IPR cases",
      "conditions": [
        {
          "field": "caseType",
          "operator": "includes",
          "value": ["conversion", "ipr"]
        }
      ]
    },
    {
      "form": "A1001NY",
      "description": "Additional Insured Supplement",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when an additional insured is requested",
      "conditions": [
        {
          "field": "additionalInsured",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "A1002P-NY",
      "description": "Application for Simplified Conversion",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for a simplified Conversion case",
      "conditions": [
        {
          "field": "caseType",
          "operator": "equals",
          "value": "conversion"
        }
      ]
    },
    {
      "form": "A1500P-NY",
      "description": "CareChoice Application",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for a CareChoice case",
      "conditions": [
        {
          "field": "productType",
          "operator": "equals",
          "value": "careChoice"
        }
      ]
    },
    {
      "form": "LTCR-NY",
      "description": "LTC Access Rider Application Package",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when the LTC Access Rider is elected",
      "conditions": [
        {
          "field": "productType",
          "operator": "equals",
          "value": "ltcr"
        }
      ]
    },
    {
      "form": "F6290NY-US",
      "description": "Foreign Supplement",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when applicable foreign travel, residency, or activity is indicated",
      "conditions": [
        {
          "field": "foreignActivity",
          "operator": "equals",
          "value": "yes"
        }
      ]
    },
    {
      "form": "FR2118",
      "description": "Long Term Care Personal Worksheet",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for an LTC Access Rider or CareChoice case",
      "conditions": [
        {
          "field": "productType",
          "operator": "includes",
          "value": ["ltcr", "careChoice"]
        }
      ]
    },
    {
      "form": "N201-NY-399",
      "description": "Minimum Death Benefit Disclosure",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for Variable Life applications",
      "conditions": [
        {
          "field": "productType",
          "operator": "equals",
          "value": "variableLife"
        }
      ]
    },
    {
      "form": "F3669",
      "description": "Supplement to Application for Variable Life Insurance",
      "required": false,
      "reviewRequired": true,
      "condition": "Required for Variable Life applications",
      "conditions": [
        {
          "field": "productType",
          "operator": "equals",
          "value": "variableLife"
        }
      ]
    },
    {
      "form": "FR1126NY",
      "description": "Internal Term-to-Term Replacement Authorization",
      "required": false,
      "reviewRequired": true,
      "condition": "Required when an Internal Term-to-Term replacement is requested",
      "conditions": [
        {
          "field": "internalTermReplacement",
          "operator": "equals",
          "value": "yes"
        }
      ]
    }
  ],
